<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Vendedores</title><link rel="stylesheet" href="/style.css"></head><body><header><a href="/">← Panel</a><b>Administración</b></header><main><h1>Vendedores</h1><% if(message){ %><p class="alert"><%= message %></p><% } %><section class="panel"><h2>Crear vendedor</h2><form method="post" action="/admin/users"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Usuario (min. 3 caracteres)<input name="username" minlength="3" maxlength="60" required></label><label>Contraseña (min. 10 caracteres)<input name="password" type="password" minlength="10" required></label><button>Crear cuenta</button></form></section><section class="panel"><h2>Cuentas existentes</h2><div class="tablewrap"><table><thead><tr><th>Usuario</th><th>Rol</th><th>Estado</th><th>Acción</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><%= u.username %></td><td><%= u.role %></td><td><%= u.active?'Activa':'Bloqueada' %></td><td><% if(u.role==='seller'){ %><form method="post" action="/admin/users/<%= u.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="small secondary"><%= u.active?'Bloquear':'Activar' %></button></form><% } %></td></tr><% }) %></tbody></table></div></section></main></body></html>
