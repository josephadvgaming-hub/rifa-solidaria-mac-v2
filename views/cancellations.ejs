<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Anulaciones</title><link rel="stylesheet" href="/style.css"></head><body><header><a href="/">← Panel</a></header><main><h1>Historial de anulaciones</h1><div class="tablewrap"><table><tr><th>Fecha</th><th>Número</th><th>Comprador</th><th>Motivo</th><th>Devolución</th><th>Admin</th></tr><% rows.forEach(r=>{ %><tr><td><%= r.cancelled_at.toLocaleString('es-CL') %></td><td><%= r.letter %>-<%= String(r.number).padStart(2,'0') %></td><td><%= r.buyer_name %></td><td><%= r.reason %></td><td><%= r.refund_state %></td><td><%= r.actor %></td></tr><% }) %></table></div></main></body></html>