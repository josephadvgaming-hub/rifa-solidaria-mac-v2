<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Compradores</title><link rel="stylesheet" href="/style.css"></head><body><header><a href="/">← Panel</a><b>Buscar compradores</b></header><main><h1>Buscar compradores</h1><form method="get"><label>Nombre, teléfono o número (A-15)<input name="q" value="<%= q %>" maxlength="100" required></label><button>Buscar</button></form><% if(q){ %><p><%= rows.length %> coincidencias (máximo 150)</p><div class="tablewrap"><table><thead><tr><th>Número</th><th>Comprador</th><th>Teléfono</th><th>Estado</th><th>Vendedor</th><th>Comprobante</th></tr></thead><tbody><% rows.forEach(t=>{const code=t.letter+'-'+String(t.number).padStart(2,'0'); const msg='🐾 Rifa Solidaria por Mac\nComprador: '+t.buyer_name+'\nNúmero: '+code+'\nValor: $1.000\nEstado: '+(t.status==='paid'?'Pago confirmado':'Reservado (pendiente de pago)')+'\n¡Gracias por ayudar a Mac! ❤️';const phone=t.buyer_phone.replace(/\D/g,''); %><tr><td><%= code %></td><td><%= t.buyer_name %></td><td><%= t.buyer_phone %></td><td><%= t.status %></td><td><%= t.seller %></td><td><a target="_blank" rel="noopener noreferrer" href="https://wa.me/<%= phone %>?text=<%= encodeURIComponent(msg) %>">WhatsApp</a></td></tr><% }) %></tbody></table></div><% } %></main></body></html>